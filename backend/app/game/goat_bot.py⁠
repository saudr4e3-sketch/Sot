    emotional_pressure: float = 0.0


# ==================== NEURAL NETWORK SIMULATOR ====================

class NeuralOpponentProfiler:
    """
    Advanced neural network simulator for opponent behavior prediction.
    Uses Bayesian inference and pattern recognition to model opponent psychology.
    """
    
    def __init__(self):
        self.opponent_profiles: Dict[str, PlayerProfile] = {}
        self.behavioral_patterns = {
            "aggressive": {"bid_multiplier": 1.4, "trap_vulnerability": 0.8},
            "conservative": {"bid_multiplier": 0.7, "trap_vulnerability": 0.2},
            "reactive": {"bid_multiplier": 1.0, "trap_vulnerability": 0.6},
            "strategic": {"bid_multiplier": 1.1, "trap_vulnerability": 0.3},
            "emotional": {"bid_multiplier": 1.6, "trap_vulnerability": 0.9}
        }
        self.prediction_weights = {
            "speed": 0.25,
            "aggression": 0.30,
            "history": 0.20,
            "phase": 0.15,
            "emotional_state": 0.10
        }
        
    def analyze_opponent_action(
        self, 
        player_id: str, 
        action: str, 
        bid_amount: float = 0.0, 
        response_time: float = 0.0
    ) -> Dict[str, Any]:
        """
        Analyze single opponent action and update neural profile.
        Returns prediction of next move with confidence score.
        """
        if player_id not in self.opponent_profiles:
            self.opponent_profiles[player_id] = PlayerProfile(player_id=player_id)
        
        profile = self.opponent_profiles[player_id]
        profile.total_auctions_observed += 1
        
        # Update bid speed model
        if profile.bid_speed_avg == 0:
            profile.bid_speed_avg = response_time
        else:
            profile.bid_speed_avg = 0.7 * profile.bid_speed_avg + 0.3 * response_time
        
        # Update aggression model
        aggression_delta = 0.1 if action == "aggressive_bid" else -0.05
        profile.bid_aggression = max(0.0, min(1.0, 
            profile.bid_aggression + aggression_delta))
        
        # Update hesitation model
        if action == "skip" or response_time > 5.0:
            profile.hesitation_count += 1
            profile.bid_aggression = max(0.0, profile.bid_aggression - 0.15)
        
        # Store bid history
        if bid_amount > 0:
            profile.recent_bids.append({
                "amount": bid_amount,
                "time": time.time(),
                "action": action
            })
            if len(profile.recent_bids) > 0:
                avg_bid = sum(b["amount"] for b in profile.recent_bids) / len(profile.recent_bids)
                if avg_bid > 0:
                    profile.max_bid_ratio = max(profile.max_bid_ratio, bid_amount / avg_bid)
        
        # Classify psychological state
        profile.psychological_state = self._classify_psychological_state(profile)
        
        # Predict next move
        prediction = self._predict_next_move(profile)
        
        return prediction
    
    def _classify_psychological_state(self, profile: PlayerProfile) -> str:
        """Classify opponent's psychological state based on behavior patterns"""
        if profile.bid_aggression > 0.7 and profile.hesitation_count < 3:
            return "aggressive"
        elif profile.bid_aggression < 0.3 and profile.hesitation_count > 5:
            return "conservative"
        elif profile.bluff_frequency > 0.4:
            return "reactive"
        elif profile.hesitation_count > 3 and profile.bid_aggression < 0.5:
            return "strategic"
        else:
            return "emotional"
    
    def _predict_next_move(self, profile: PlayerProfile) -> Dict[str, Any]:
        """
        Neural prediction of opponent's next action.
        Uses weighted features for probabilistic forecasting.
        """
        state = self.behavioral_patterns.get(
            profile.psychological_state, 
            self.behavioral_patterns["reactive"]
        )
        
        # Calculate prediction scores
        aggression_score = profile.bid_aggression * self.prediction_weights["aggression"]
        speed_score = (1.0 if profile.bid_speed_avg < 2.0 else 
                      0.5 if profile.bid_speed_avg < 5.0 else 0.2)
        speed_score *= self.prediction_weights["speed"]
        history_score = min(1.0, len(profile.recent_bids) / 10) * self.prediction_weights["history"]
        
        total_confidence = aggression_score + speed_score + history_score
        total_confidence = min(0.95, max(0.1, total_confidence))
        
        profile.prediction_confidence = total_confidence
        
        # Predict likely actions
        likely_bid = state["bid_multiplier"] * (1.0 + random.gauss(0, 0.1))
        likely_skip = 1.0 - profile.bid_aggression
        likely_aggressive = profile.bid_aggression * 0.7
        
        return {
            "likely_action": "aggressive_bid" if likely_aggressive > 0.5 else 
                           "bid" if profile.bid_aggression > 0.3 else "skip",
            "confidence": total_confidence,
            "predicted_bid_multiplier": likely_bid,
            "psychological_state": profile.psychological_state,
            "trap_vulnerability": state["trap_vulnerability"]
        }
    
    def estimate_opponent_budget(self, player_id: str) -> float:
        """Estimate opponent's remaining budget using observed behavior"""
        profile = self.opponent_profiles.get(player_id)
        if not profile or len(profile.recent_bids) < 2:
            return 100.0
        
        total_spent = sum(b["amount"] for b in profile.recent_bids)
        avg_spend_rate = total_spent / len(profile.recent_bids)
        estimated_total = 100.0
        
        # Bayesian budget estimation
        if profile.bid_aggression > 0.6:
            estimated_total *= 0.9
        elif profile.bid_aggression < 0.3:
            estimated_total *= 1.1
            
        profile.budget_estimate = max(0, estimated_total - total_spent)
        return profile.budget_estimate


