# ==================== MATHEMATICAL BUDGET OPTIMIZER ====================

class BudgetOptimizer:
    """
    Advanced financial modeling for optimal resource allocation.
    Uses predictive analytics and ROI optimization for budget management.
    """
    
    def __init__(self, initial_budget: float = 100.0):
        self.initial_budget = initial_budget
        self.remaining_budget = initial_budget
        self.acquired_cards: List[CardValuation] = []
        self.upcoming_cards: List[Dict[str, Any]] = []
        self.investment_history: List[Dict[str, Any]] = []
        self.risk_profile = RiskLevel.MODERATE
        
    def set_upcoming_cards(self, cards: List[Dict[str, Any]]):
        """Set the queue of upcoming cards for forward planning"""
        self.upcoming_cards = cards
        
    def calculate_card_valuation(
        self, 
        player_name: str, 
        position: str, 
        base_price: float,
        market_temperature: float = 0.5
    ) -> CardValuation:
        """
        Calculate comprehensive card valuation using multi-factor model.
        Implements discounted cash flow analysis adapted for fantasy football.
        """
        # Position scarcity premium
        position_multipliers = {
            "GK": 0.8, "DEF": 0.9, "MID": 1.1, "ATT": 1.3, "MGR": 1.0
        }
        position_factor = position_multipliers.get(position, 1.0)
        
        # Market demand calculation based on remaining supply
        similar_positions_in_queue = sum(
            1 for card in self.upcoming_cards 
            if card.get("position") == position
        )
        scarcity_factor = 1.0 / (1.0 + similar_positions_in_queue * 0.1)
        
        # Squad synergy value
        squad_positions = [card.position for card in self.acquired_cards]
        position_count = squad_positions.count(position)
        synergy_value = 1.0 + (position_count * 0.05)  # Synergy bonus
        
        # Calculate base value with market adjustments
        adjusted_base = base_price * position_factor * scarcity_factor * synergy_value
        
        # Predicted peak based on market conditions
        demand_pressure = market_temperature * 0.4 + 0.6
        predicted_peak = adjusted_base * demand_pressure * (1.0 + random.gauss(0, 0.05))
        
        # Risk score calculation
        budget_remaining_ratio = self.remaining_budget / self.initial_budget
        risk_score = (
            (1.0 - scarcity_factor) * 0.3 +
            (1.0 - budget_remaining_ratio) * 0.4 +
            market_temperature * 0.3
        )
        risk_score = max(0.1, min(0.95, risk_score))
        
        # ROI estimation
        estimated_market_value = predicted_peak * 0.85  # Conservative estimate
        roi_estimate = ((estimated_market_value - adjusted_base) / adjusted_base) * 100
        
        # Optimal bid calculation using Kelly Criterion adaptation
        win_probability = 1.0 - risk_score
        loss_probability = risk_score
        payoff_ratio = roi_estimate / 100 if roi_estimate > 0 else 0.1
        
        if payoff_ratio > 0:
            kelly_fraction = (win_probability * (payoff_ratio + 1) - 1) / payoff_ratio
            kelly_fraction = max(0.1, min(0.4, kelly_fraction))  # Cap Kelly fraction
        else:
            kelly_fraction = 0.05
            
        optimal_bid = adjusted_base * (1.0 + kelly_fraction * payoff_ratio)
        optimal_bid = min(optimal_bid, self.remaining_budget * 0.4)  # Budget cap
        
        return CardValuation(
            player_name=player_name,
            position=position,
            base_value=adjusted_base,
            market_demand=demand_pressure,
            scarcity_factor=scarcity_factor,
            synergy_value=synergy_value,
            predicted_peak=predicted_peak,
            roi_estimate=roi_estimate,
            risk_score=risk_score,
            optimal_bid=optimal_bid
        )
    
    def should_bid(
        self, 
        current_bid: float, 
        card_valuation: CardValuation,
        opponent_profile: PlayerProfile,
        auction_phase: AuctionPhase
    ) -> Tuple[bool, float, str]:
        """
        Determine if bot should bid and at what amount.
        Returns (should_bid, bid_amount, strategy_reason)
        """
        metrics = self.get_risk_metrics()
        
        # Hard stop conditions
        if current_bid >= card_valuation.predicted_peak * 1.2:
            return False, 0.0, "تجاوز السعر القيمة المتوقعة بنسبة 120%"
        
        if current_bid > self.remaining_budget * 0.5:
            return False, 0.0, "المزايدة تتجاوز 50% من الميزانية المتبقية"
        
        if auction_phase == AuctionPhase.FINAL and current_bid > card_valuation.optimal_bid * 1.1:
            return False, 0.0, "مرحلة الإغلاق وسعر مرتفع - انسحاب استراتيجي"
        
        # Calculate dynamic bid amount
        aggression_multiplier = 1.0
        
        if auction_phase == AuctionPhase.OPENING:
            aggression_multiplier = 0.8 + (metrics["aggression"] * 0.3)
        elif auction_phase == AuctionPhase.MIDDLE:
            aggression_multiplier = 0.9 + (metrics["aggression"] * 0.4)
        elif auction_phase == AuctionPhase.CLOSING:
            aggression_multiplier = 1.0 + (metrics["aggression"] * 0.5)
        else:
            aggression_multiplier = 1.1 + (metrics["aggression"] * 0.6)
        
        # Psychological adjustment based on opponent
        if opponent_profile.psychological_state == "emotional":
            aggression_multiplier *= 1.2
        
        bid_amount = min(
            current_bid * aggression_multiplier,
            card_valuation.optimal_bid * 1.15,
            self.remaining_budget * 0.35
        )
        
        # ROI-based decision
        if card_valuation.roi_estimate < -10:
            strategy = "عائد استثمار سلبي - تفادي المخاطرة"
            if random.random() > 0.3:  # 70% chance to skip
                return False, 0.0, strategy
        
        strategy = f"قيمة متوقعة إيجابية (ROI: {card_valuation.roi_estimate:.1f}%)"
        return True, bid_amount, strategy
    
    def get_risk_metrics(self) -> Dict[str, float]:
        """Get current risk metrics and financial status"""
        spent_ratio = 1.0 - (self.remaining_budget / self.initial_budget)
        avg_card_value = 0.0
        
        if self.acquired_cards:
            avg_card_value = sum(c.base_value for c in self.acquired_cards) / len(self.acquired_cards)
        
        return {
            "remaining": self.remaining_budget,
            "spent_ratio": spent_ratio,
            "aggression": self.risk_profile.value,
            "avg_card_value": avg_card_value,
            "cards_acquired": len(self.acquired_cards),
            "budget_per_card": self.remaining_budget / max(1, 9 - len(self.acquired_cards))
        }
    
    def update_budget(self, amount_spent: float):
        """Update remaining budget after a purchase"""
        self.remaining_budget -= amount_spent
        self.investment_history.append({
            "amount": amount_spent,
            "remaining": self.remaining_budget,
            "timestamp": time.time()
        })
        
        # Adjust risk profile based on remaining budget
        budget_ratio = self.remaining_budget / self.initial_budget
        if budget_ratio < 0.3:
            self.risk_profile = RiskLevel.CONSERVATIVE
        elif budget_ratio < 0.5:
            self.risk_profile = RiskLevel.MODERATE
        elif budget_ratio < 0.7:
            self.risk_profile = RiskLevel.AGGRESSIVE
        else:
            self.risk_profile = RiskLevel.RECKLESS


