@dataclass
class PlayerProfile:
    """Neural profiling data structure for opponent modeling"""
    player_id: str = ""
    bid_speed_avg: float = 0.0  # Average response time in seconds
    bid_aggression: float = 0.0  # 0-1 scale of bid aggressiveness
    max_bid_ratio: float = 0.0  # Max bid relative to card value
    hesitation_count: int = 0  # Times player hesitated/skipped
    bluff_frequency: float = 0.0  # Detected bluffing frequency
    trap_sensitivity: float = 0.0  # How often falls into traps
    budget_estimate: float = 100.0  # Estimated remaining budget in millions
    recent_bids: deque = field(default_factory=lambda: deque(maxlen=20))
    psychological_state: str = "neutral"
    prediction_confidence: float = 0.0
    exploited_traps: int = 0
    total_auctions_observed: int = 0


@dataclass
class CardValuation:
    """Comprehensive card valuation model"""
    player_name: str
    position: str
    base_value: float
    market_demand: float  # 0-1 scale
    scarcity_factor: float
    synergy_value: float  # Value to current squad composition
    predicted_peak: float  # Predicted maximum bid
    roi_estimate: float  # Return on investment percentage
    risk_score: float  # 0-1 risk score
    optimal_bid: float  # Calculated optimal bid amount


@dataclass
class AuctionState:
    """Complete state tracking for current auction"""
    card_name: str
    position: str
    starting_price: float
    current_bid: float = 0.0
    bot_bid_count: int = 0
    opponent_bid_count: int = 0
    skipped_rounds: int = 0
    elapsed_seconds: float = 0.0
    phase: AuctionPhase = AuctionPhase.OPENING
    temperature: float = 0.5  # Auction heat 0-1
    opponent_aggression: float = 0.0
    trap_activated: bool = False
